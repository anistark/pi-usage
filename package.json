{
  "name": "pi-usage",
  "version": "0.1.0",
  "description": "Multi-provider AI usage monitor TUI — Claude, OpenAI, OpenRouter and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-usage": "dist/index.js"
  },
  "files": [
    "dist",
    "extensions"
  ],
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "claude",
    "anthropic",
    "openai",
    "openrouter",
    "usage",
    "quota",
    "billing",
    "tui",
    "cli",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "smol-toml": "^1.3.1"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
